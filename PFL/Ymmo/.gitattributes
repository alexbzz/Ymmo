# Auto detect text files and normalize line endings to LF
* text=auto

# Files with these extensions should always use LF
*.js text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.html text eol=lf
*.css text eol=css eol=lf
*.scss text eol=lf
*.py text eol=lf
*.sql text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.prisma text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.jar binary
*.exe binary
